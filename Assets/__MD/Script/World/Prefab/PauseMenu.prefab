  originalText: "\u0633\u06A9\u0647 \u062F\u0627\u0631\u06CC\u06A9 \u06CC\u06A9\u06CC
    \u0627\u0632 \u0645\u0634\u0647\u0648\u0631\u062A\u0631\u06CC\u0646 \u0648 \u0627\u0631\u0632\u0634\u0645\u0646\u062F\u062A\u0631\u06CC\u0646
    \u0633\u06A9\u0647\u200C\u0647\u0627\u06CC \u0637\u0644\u0627\u06CC \u0627\u06CC\u0631\u0627\u0646
    \u0628\u0627\u0633\u062A\u0627\u0646 \u0627\u0633\u062A \u06A9\u0647 \u062F\u0631
    \u062F\u0648\u0631\u0627\u0646 \u0627\u0645\u067E\u0631\u0627\u062A\u0648\u0631\u06CC
    \u0647\u062E\u0627\u0645\u0646\u0634\u06CC \u0648 \u0628\u0647 \u0641\u0631\u0645\u0627\u0646
    \u062F\u0627\u0631\u06CC\u0648\u0634 \u0627\u0648\u0644 (\u06F5\u06F2\u06F2 \u062A\u0627
    \u06F4\u06F8\u06F6 \u067E\u06CC\u0634 \u0627\u0632 \u0645\u06CC\u0644\u0627\u062F)
    \u0636\u0631\u0628 \u0634\u062F. \u0646\u0627\u0645 \xAB\u062F\u0627\u0631\u06CC\u06A9\xBB
    \u0627\u0632 \u0646\u0627\u0645 \u062F\u0627\u0631\u06CC\u0648\u0634 \u06AF\u0631\u0641\u062A\u0647
    \u0634\u062F\u0647 \u0648 \u0627\u06CC\u0646 \u0633\u06A9\u0647 \u0628\u0647
    \u062F\u0644\u06CC\u0644 \u062E\u0644\u0648\u0635 \u0628\u0627\u0644\u0627\u06CC
    \u0637\u0644\u0627 \u0648 \u06A9\u06CC\u0641\u06CC\u062A \u0633\u0627\u062E\u062A\u060C
    \u062F\u0631 \u0633\u0631\u0627\u0633\u0631 \u0642\u0644\u0645\u0631\u0648 \u0647\u062E\u0627\u0645\u0646\u0634\u06CC
    \u0648 \u062D\u062A\u06CC \u062E\u0627\u0631\u062C \u0627\u0632 \u0645\u0631\u0632\u0647\u0627\u06CC
    \u0622\u0646 \u0627\u0639\u062A\u0628\u0627\u0631 \u0641\u0631\u0627\u0648\u0627\u0646\u06CC
    \u062F\u0627\u0634\u062A.\n\n\u062F\u0627\u0631\u06CC\u06A9 \u0627\u0632 \u0637\u0644\u0627\u06CC
    \u062E\u0627\u0644\u0635 \u0633\u0627\u062E\u062A\u0647 \u0645\u06CC\u200C\u0634\u062F
    \u0648 \u0648\u0632\u0646 \u0622\u0646 \u062D\u062F\u0648\u062F \u06F8\u066B\u06F4
    \u06AF\u0631\u0645 \u0628\u0648\u062F. \u0628\u0631 \u0631\u0648\u06CC \u0627\u06CC\u0646
    \u0633\u06A9\u0647 \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062A\u0635\u0648\u06CC\u0631
    \u0634\u0627\u0647 \u0647\u062E\u0627\u0645\u0646\u0634\u06CC \u06CC\u0627 \u06CC\u06A9
    \u06A9\u0645\u0627\u0646\u062F\u0627\u0631 \u067E\u0627\u0631\u0633\u06CC \u062F\u06CC\u062F\u0647
    \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u0646\u0645\u0627\u062F\u06CC
    \u0627\u0632 \u0642\u062F\u0631\u062A\u060C \u0627\u0642\u062A\u062F\u0627\u0631
    \u0648 \u0622\u0645\u0627\u062F\u06AF\u06CC \u0646\u0638\u0627\u0645\u06CC \u0627\u0645\u067E\u0631\u0627\u062A\u0648\u0631\u06CC
    \u0628\u0647 \u0634\u0645\u0627\u0631 \u0645\u06CC\u200C\u0631\u0641\u062A. \u062F\u0631
    \u067E\u0634\u062A \u0633\u06A9\u0647 \u0646\u06CC\u0632 \u0641\u0631\u0648\u0631\u0641\u062A\u06AF\u06CC\u200C\u0647\u0627\u06CC
    \u0646\u0627\u0634\u06CC \u0627\u0632 \u0641\u0631\u0622\u06CC\u0646\u062F \u0636\u0631\u0628
    \u062F\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u062F \u06A9\u0647 \u0627\u0632
    \u0648\u06CC\u0698\u06AF\u06CC\u200C\u0647\u0627\u06CC \u0631\u0627\u06CC\u062C
    \u0633\u06A9\u0647\u200C\u0647\u0627\u06CC \u0622\u0646 \u062F\u0648\u0631\u0647
    \u0628\u0648\u062F.\n\n\u0631\u0648\u0627\u062C \u062F\u0627\u0631\u06CC\u06A9
    \u0646\u0642\u0634 \u0645\u0647\u0645\u06CC \u062F\u0631 \u0631\u0648\u0646\u0642
    \u062A\u062C\u0627\u0631\u062A\u060C \u067E\u0631\u062F\u0627\u062E\u062A \u062D\u0642\u0648\u0642
    \u0633\u0631\u0628\u0627\u0632\u0627\u0646\u060C \u062C\u0645\u0639\u200C\u0622\u0648\u0631\u06CC
    \u0645\u0627\u0644\u06CC\u0627\u062A \u0648 \u06AF\u0633\u062A\u0631\u0634 \u0631\u0648\u0627\u0628\u0637
