    \u0645\u06CC\u200C\u062A\u0648\u0627\u0646 \u062F\u0631 \u062A\u062E\u062A \u062C\u0645\u0634\u06CC\u062F\u060C
    \u0646\u0642\u0634 \u0631\u0633\u062A\u0645 \u0648 \u0634\u0648\u0634 \u0645\u0634\u0627\u0647\u062F\u0647
    \u06A9\u0631\u062F.\n\n\u0647\u0646\u0631\u0645\u0646\u062F\u0627\u0646 \u0647\u062E\u0627\u0645\u0646\u0634\u06CC
    \u062F\u0631 \u0627\u06CC\u0646 \u0633\u0646\u06AF\u200C\u0646\u06AF\u0627\u0631\u0647\u200C\u0647\u0627
    \u0628\u0627 \u062F\u0642\u062A \u0648 \u0638\u0631\u0627\u0641\u062A \u0641\u0631\u0627\u0648\u0627\u0646\u060C
    \u0635\u062D\u0646\u0647\u200C\u0647\u0627\u06CC\u06CC \u0627\u0632 \u0645\u0631\u0627\u0633\u0645
    \u0631\u0633\u0645\u06CC\u060C \u062D\u0636\u0648\u0631 \u0646\u0645\u0627\u06CC\u0646\u062F\u06AF\u0627\u0646
    \u0645\u0644\u0644 \u06AF\u0648\u0646\u0627\u06AF\u0648\u0646\u060C \u0633\u0631\u0628\u0627\u0632\u0627\u0646
    \u06AF\u0627\u0631\u062F \u062C\u0627\u0648\u06CC\u062F\u0627\u0646\u060C \u0628\u0632\u0631\u06AF\u0627\u0646
