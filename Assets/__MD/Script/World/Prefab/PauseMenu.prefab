    \u062E\u0634\u0627\u06CC\u0627\u0631\u0634\u0627 \u0648 \u0627\u0631\u062F\u0634\u06CC\u0631
    \u06CC\u06A9\u0645 \u0628\u0631 \u0631\u0648\u06CC \u0635\u062E\u0631\u0647\u200C\u0647\u0627\u060C
