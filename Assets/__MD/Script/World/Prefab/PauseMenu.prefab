    \u0647\u062E\u0627\u0645\u0646\u0634\u06CC\u060C \u0646\u0645\u0627\u06CC\u0634
    \u0627\u062A\u062D\u0627\u062F \u0648 \u0647\u0645\u0632\u06CC\u0633\u062A\u06CC
    \u0645\u0644\u062A\u200C\u0647\u0627\u06CC \u0645\u062E\u062A\u0644\u0641 \u062A\u062D\u062A
    \u0641\u0631\u0645\u0627\u0646\u0631\u0648\u0627\u06CC\u06CC \u0634\u0627\u0647\u0646\u0634\u0627\u0647\u06CC
    \u0627\u06CC\u0631\u0627\u0646 \u0627\u0633\u062A. \u062F\u0631 \u0628\u0633\u06CC\u0627\u0631\u06CC
    \u0627\u0632 \u0627\u06CC\u0646 \u0622\u062B\u0627\u0631\u060C \u0646\u0645\u0627\u06CC\u0646\u062F\u06AF\u0627\u0646
    \u0633\u0631\u0632\u0645\u06CC\u0646\u200C\u0647\u0627\u06CC \u06AF\u0648\u0646\u0627\u06AF\u0648\u0646
    \u0628\u0627 \u0647\u062F\u0627\u06CC\u0627\u06CC \u062E\u0648\u062F \u062F\u0631
    \u062D\u0627\u0644 \u0627\u062F\u0627\u06CC \u0627\u062D\u062A\u0631\u0627\u0645
    \u0628\u0647 \u0634\u0627\u0647 \u062F\u06CC\u062F\u0647 \u0645\u06CC\u200C\u0634\u0648\u0646\u062F
    \u06A9\u0647 \u0646\u0645\u0627\u062F\u06CC \u0627\u0632 \u0627\u0642\u062A\u062F\u0627\u0631\u060C
    \u0646\u0638\u0645 \u0648 \u0635\u0644\u062D \u062F\u0631 \u0627\u0645\u067E\u0631\u0627\u062A\u0648\u0631\u06CC
    \u0647\u062E\u0627\u0645\u0646\u0634\u06CC \u0627\u0633\u062A.\n\n\u0627\u0645\u0631\u0648\u0632\u0647
    \u0633\u0646\u06AF\u200C\u0646\u06AF\u0627\u0631\u0647\u200C\u0647\u0627\u06CC
    \u0647\u062E\u0627\u0645\u0646\u0634\u06CC \u0628\u0647 \u0639\u0646\u0648\u0627\u0646
