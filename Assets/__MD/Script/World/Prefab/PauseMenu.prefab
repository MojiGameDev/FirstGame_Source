    \u0631\u0627 \u0628\u0647 \u062A\u0635\u0648\u06CC\u0631 \u06A9\u0634\u06CC\u062F\u0647\u200C\u0627\u0646\u062F.
    \u0627\u06CC\u0646 \u0646\u0642\u0634\u200C\u0647\u0627 \u0639\u0644\u0627\u0648\u0647
