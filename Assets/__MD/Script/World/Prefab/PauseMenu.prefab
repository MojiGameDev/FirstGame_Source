  originalText: "\u0633\u0646\u06AF\u200C\u0646\u06AF\u0627\u0631\u0647\u200C\u0647\u0627\u06CC
    \u0647\u062E\u0627\u0645\u0646\u0634\u06CC \u0627\u0632 \u0627\u0631\u0632\u0634\u0645\u0646\u062F\u062A\u0631\u06CC\u0646
    \u0622\u062B\u0627\u0631 \u0647\u0646\u0631\u06CC \u0648 \u062A\u0627\u0631\u06CC\u062E\u06CC
    \u0627\u06CC\u0631\u0627\u0646 \u0628\u0627\u0633\u062A\u0627\u0646 \u0647\u0633\u062A\u0646\u062F
    \u06A9\u0647 \u0634\u06A9\u0648\u0647\u060C \u0642\u062F\u0631\u062A \u0648 \u0641\u0631\u0647\u0646\u06AF
    \u0627\u0645\u067E\u0631\u0627\u062A\u0648\u0631\u06CC \u0647\u062E\u0627\u0645\u0646\u0634\u06CC
    \u0631\u0627 \u0628\u0647 \u062A\u0635\u0648\u06CC\u0631 \u0645\u06CC\u200C\u06A9\u0634\u0646\u062F.
    \u0627\u06CC\u0646 \u0622\u062B\u0627\u0631 \u0628\u06CC\u0634\u062A\u0631 \u062F\u0631
    \u062F\u0648\u0631\u0647 \u067E\u0627\u062F\u0634\u0627\u0647\u0627\u0646\u06CC
